generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                  String           @id @default(uuid())
  name                String
  domain              String?
  subscriptionStatus  String           @default("active")
  subscriptionEndDate DateTime?
  createdAt           DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  clients         Client[]
  contracts       Contract[]
  invoices        Invoice[]
  matters         Matter[]
  users           User[]
  messages        MatterMessage[]
  notifications   Notification[]
  complianceCases ComplianceCase[]
  knowledgeItems  KnowledgeItem[]
  portalShares      PortalShare[]
  caseFolders       CaseFolder[]
  importDrafts      MatterImportDraft[]
  tasks             Task[]
  hearings          Hearing[]
  auditLogs         AuditLog[]
  documentTemplates DocumentTemplate[]
  conflictChecks    MatterConflictCheck[]
  parties           MatterParty[]
  deadlines         MatterDeadline[]
  feeAgreements     MatterFeeAgreement[]
  payments          MatterPayment[]
  matterAccessList  MatterAccess[]
  developmentProjectProfiles DevelopmentProjectProfile[]
}

model User {
  id                     String                 @id @default(uuid())
  tenantId               String
  name                   String
  email                  String                 @unique
  password               String
  mustChangePassword     Boolean                @default(false)
  sessionVersion         Int                    @default(0)
  canCreateCase          Boolean                @default(false)
  modulePermissions      String                 @default("{}")
  role                   String
  isActive               Boolean                @default(true)
  mfaEnabled             Boolean                @default(false)
  mfaSecret              String?
  avatarUrl              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  matters                Matter[]               @relation("LawyerMatters")
  tasks                  Task[]
  matterStatusUpdates    Matter[]               @relation("MatterStatusUpdater")
  statusHistory          MatterStatusHistory[]
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  messages               MatterMessage[]
  mentions               MatterMessageMention[]
  notifications          Notification[]
  teamMatters            Matter[]               @relation("MatterTeam")
  archivedMatters        Matter[]               @relation("MatterArchiver")
  authoredKnowledgeItems KnowledgeItem[]        @relation("KnowledgeAuthors")
  createdFolders         CaseFolder[]           @relation("FolderCreator")
  viewableFolders        CaseFolder[]           @relation("FolderViewers")
  uploadedImportDrafts   MatterImportDraft[]    @relation("ImportUploadedBy")
  confirmedImportDrafts  MatterImportDraft[]    @relation("ImportConfirmedBy")
  authoredTemplates      DocumentTemplate[]     @relation("TemplateAuthors")
  updatedTemplates       DocumentTemplate[]     @relation("TemplateUpdaters")
  acknowledgedConflicts  MatterConflictCheck[]  @relation("ConflictAcknowledger")
  createdDeadlines       MatterDeadline[]       @relation("DeadlineCreator")
  assignedDeadlines      MatterDeadline[]       @relation("DeadlineAssignee")
  receivedPayments       MatterPayment[]        @relation("PaymentReceiver")
  matterAccessList       MatterAccess[]         @relation("UserMatterAccess")
  grantedAccessList      MatterAccess[]         @relation("AccessGrantor")
  auditLogs              AuditLog[]
}

model Client {
  id              String           @id @default(uuid())
  tenantId        String
  name            String
  email           String?
  phone           String?
  type            String           @default("individual")
  status          String           @default("active")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  contracts       Contract[]
  invoices        Invoice[]
  matters         Matter[]
  beneficiaryMatters Matter[]       @relation("BeneficiaryAccount")
  complianceCases ComplianceCase[]
  portalShares    PortalShare[]
}

model Matter {
  id         String     @id @default(uuid())
  tenantId   String
  clientId   String?
  beneficiaryAccountId String?
  title      String
  caseNumber String?
  status     String     @default("NEW")
  statusUpdatedAt DateTime?
  statusUpdatedById String?
  lawyerId   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  documents  Document[]
  hearings   Hearing[]
  invoices   Invoice[]
  lawyer     User?      @relation("LawyerMatters", fields: [lawyerId], references: [id])
  client     Client?    @relation(fields: [clientId], references: [id])
  beneficiaryAccount Client? @relation("BeneficiaryAccount", fields: [beneficiaryAccountId], references: [id], onDelete: Restrict)
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  tasks      Task[]
  statusUpdatedBy User? @relation("MatterStatusUpdater", fields: [statusUpdatedById], references: [id])
  statusHistory MatterStatusHistory[]

  folderId   String?
  folder     CaseFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  externalPartyName  String?
  externalPartyType  String?
  externalPartyPhone String?
  externalPartyEmail String?
  externalPartyNotes String?
  notes              String?
  dueDate            DateTime?

  isArchived         Boolean   @default(false)
  archivedAt         DateTime?
  archivedById       String?
  archiveReason      String?

  archivedBy   User?           @relation("MatterArchiver", fields: [archivedById], references: [id])
  teamMembers  User[]          @relation("MatterTeam")
  messages     MatterMessage[]
  portalShares PortalShare[]

  parties       MatterParty[]
  deadlines     MatterDeadline[]
  feeAgreement  MatterFeeAgreement?
  payments      MatterPayment[]
  accessList    MatterAccess[]
  conflictChecks MatterConflictCheck[]
  developmentProfile DevelopmentProjectProfile?

  @@index([tenantId, lawyerId])
}

model DevelopmentProjectProfile {
  id                    String   @id @default(uuid())
  tenantId              String
  matterId              String   @unique
  projectCode           String?
  city                  String?
  region                String?
  stage                 String   @default("PLANNING")
  plannedStart          DateTime?
  plannedEnd            DateTime?
  projectValue          Float    @default(0)
  budgetAtCompletion    Float    @default(0)
  plannedValue          Float    @default(0)
  earnedValue           Float    @default(0)
  actualCost            Float    @default(0)
  totalUnits            Int      @default(0)
  soldUnits             Int      @default(0)
  collectedAmount       Float    @default(0)
  offPlanStatus         String   @default("NOT_APPLICABLE")
  buildingPermitStatus  String   @default("NOT_STARTED")
  buildingCodeStatus    String   @default("NOT_STARTED")
  latentDefectsInsuranceStatus String @default("NOT_STARTED")
  occupancyStatus       String   @default("NOT_STARTED")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

model MatterStatusHistory {
  id          String   @id @default(uuid())
  matterId    String
  oldStatus   String?
  newStatus   String
  changedById String
  note        String?
  createdAt   DateTime @default(now())

  matter    Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([matterId, createdAt])
}

model Hearing {
  id        String   @id @default(uuid())
  tenantId  String?
  matterId  String
  type      String   @default("HEARING") // HEARING, DEADLINE, CLIENT_MEETING, INTERNAL_REVIEW, OTHER
  title     String?
  date      DateTime
  court     String
  summary   String?
  status    String   @default("upcoming")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matter Matter  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([matterId, date])
  @@index([tenantId, date])
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String?
  matterId    String?
  userId      String?
  title       String
  description String?
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("NEW") // NEW, IN_PROGRESS, DONE, OVERDUE, CANCELLED
  isDone      Boolean   @default(false)
  isUrgent    Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  matter Matter? @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId, status])
}

model Document {
  id        String   @id @default(uuid())
  matterId  String
  title     String
  fileUrl   String
  type      String   @default("pdf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matter    Matter   @relation(fields: [matterId], references: [id])
}

model Invoice {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  matterId  String?
  amount    Float
  status    String    @default("unpaid")
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  matter    Matter?   @relation(fields: [matterId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model Contract {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String?
  title     String
  summary   String?
  content   String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model MatterMessage {
  id               String    @id @default(uuid())
  tenantId         String
  matterId         String
  authorId         String
  body             String
  replyToMessageId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  clientRequestId  String?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  matter   Matter                 @relation(fields: [matterId], references: [id])
  author   User                   @relation(fields: [authorId], references: [id])
  replyTo  MatterMessage?         @relation("Replies", fields: [replyToMessageId], references: [id])
  replies  MatterMessage[]        @relation("Replies")
  mentions MatterMessageMention[]

  @@unique([authorId, clientRequestId])
  @@index([tenantId, matterId, createdAt])
}

model MatterMessageMention {
  id              String   @id @default(uuid())
  messageId       String
  mentionedUserId String
  createdAt       DateTime @default(now())

  message MatterMessage @relation(fields: [messageId], references: [id])
  user    User          @relation(fields: [mentionedUserId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ComplianceCase {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String?
  title       String
  caseType    String
  riskLevel   String   @default("medium")
  status      String   @default("under_review")
  restriction String?
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, riskLevel])
}

model KnowledgeItem {
  id          String   @id @default(uuid())
  tenantId    String
  createdById String
  title       String
  category    String
  content     String
  fileName    String?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdBy   User     @relation("KnowledgeAuthors", fields: [createdById], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, createdAt])
}

model PortalShare {
  id           String    @id @default(uuid())
  tenantId     String
  matterId     String
  clientId     String?
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  matter       Matter    @relation(fields: [matterId], references: [id])
  client       Client?   @relation(fields: [clientId], references: [id])

  @@index([tenantId, createdAt])
  @@index([matterId, revokedAt])
  @@index([expiresAt])
}

model CaseFolder {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdBy   User     @relation("FolderCreator", fields: [createdById], references: [id])
  viewers     User[]   @relation("FolderViewers")
  matters     Matter[]

  @@index([tenantId])
}

model MatterImportDraft {
  id               String    @id @default(uuid())
  tenantId         String
  uploadedById     String
  sourceDocumentId String?
  filePath         String
  fileName         String
  extractedData    String    // JSON string containing extracted fields
  confidence       String    // JSON string containing confidence scores per field
  status           String    @default("PENDING_REVIEW") // PENDING_REVIEW, CONFIRMED, REJECTED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  confirmedAt      DateTime?
  confirmedById    String?

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy  User     @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  confirmedBy User?    @relation("ImportConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([uploadedById])
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  category     String   @default("OTHER") // DEMAND_LETTER, CASE_STATUS_REPORT, FEE_AGREEMENT, INTERNAL_MEMO, OTHER
  practiceArea String   @default("GENERAL") // LABOR, COMMERCIAL, REAL_ESTATE, FAMILY, EXECUTION, CRIMINAL, ADMINISTRATIVE, CONSULTATION, GENERAL
  templateType String   @default("GENERAL") // DEMAND_LETTER, MEMO, CASE_REPORT, FEE_AGREEMENT, SETTLEMENT, NOTICE, GENERAL
  content      String
  isActive     Boolean  @default(true)
  createdById  String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation("TemplateAuthors", fields: [createdById], references: [id])
  updatedBy User?  @relation("TemplateUpdaters", fields: [updatedById], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, practiceArea, isActive])
}

model MatterConflictCheck {
  id               String    @id @default(uuid())
  tenantId         String
  matterId         String?
  checkedName      String
  matchedEntityType String   // CLIENT, BENEFICIARY, OPPONENT, PARTY, PREVIOUS_CASE
  matchedEntityId  String?
  riskLevel        String    // LOW, MEDIUM, HIGH
  reason           String
  acknowledgedById String?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter         Matter? @relation(fields: [matterId], references: [id], onDelete: SetNull)
  acknowledgedBy User?   @relation("ConflictAcknowledger", fields: [acknowledgedById], references: [id])

  @@index([tenantId, checkedName])
}

model MatterParty {
  id             String   @id @default(uuid())
  matterId       String
  tenantId       String
  name           String
  partyType      String   @default("PERSON") // PERSON, COMPANY, GOVERNMENT_ENTITY, OTHER
  role           String   @default("THIRD_PARTY") // CLIENT, OPPONENT, PLAINTIFF, DEFENDANT, WITNESS, EXPERT, REPRESENTATIVE, THIRD_PARTY, OTHER
  nationalIdOrCr String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId, name])
}

model MatterDeadline {
  id           String    @id @default(uuid())
  matterId     String
  tenantId     String
  title        String
  deadlineType String    @default("SUBMISSION_DEADLINE") // APPEAL_DEADLINE, REPLY_DEADLINE, SUBMISSION_DEADLINE, OBJECTION_DEADLINE, PAYMENT_DEADLINE, OTHER
  dueDate      DateTime
  reminderDate DateTime?
  status       String    @default("OPEN") // OPEN, DONE, MISSED, CANCELLED
  notes        String?
  createdById  String
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  matter     Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User   @relation("DeadlineCreator", fields: [createdById], references: [id])
  assignedTo User?  @relation("DeadlineAssignee", fields: [assignedToId], references: [id])

  @@index([matterId, dueDate])
  @@index([tenantId, status])
}

model MatterFeeAgreement {
  id            String   @id @default(uuid())
  matterId      String   @unique
  tenantId      String
  totalFee      Float
  currency      String   @default("SAR")
  paymentStatus String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, WAIVED
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentStatus])
}

model MatterPayment {
  id           String   @id @default(uuid())
  matterId     String
  tenantId     String
  amount       Float
  paymentDate  DateTime @default(now())
  method       String   @default("BANK_TRANSFER") // CASH, BANK_TRANSFER, CARD, OTHER
  reference    String?
  notes        String?
  receivedById String
  createdAt    DateTime @default(now())

  matter     Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receivedBy User   @relation("PaymentReceiver", fields: [receivedById], references: [id])

  @@index([matterId])
  @@index([tenantId])
}

model MatterAccess {
  id                  String   @id @default(uuid())
  matterId            String
  tenantId            String
  userId              String
  accessRole          String   @default("ASSIGNED_LAWYER") // RESPONSIBLE_LAWYER, ASSIGNED_LAWYER, ASSISTANT, REVIEWER, VIEWER
  canView             Boolean  @default(true)
  canEdit             Boolean  @default(false)
  canManageDocuments  Boolean  @default(true)
  canManageTasks      Boolean  @default(true)
  canManageHearings   Boolean  @default(true)
  canViewFinancials   Boolean  @default(false)
  canManageFinancials Boolean  @default(false)
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  matter    Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User   @relation("UserMatterAccess", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User   @relation("AccessGrantor", fields: [createdById], references: [id])

  @@unique([matterId, userId])
  @@index([tenantId, userId])
}



