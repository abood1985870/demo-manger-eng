generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                         String                      @id @default(uuid())
  name                       String
  domain                     String?
  subscriptionStatus         String                      @default("active")
  subscriptionEndDate        DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  auditLogs                  AuditLog[]
  caseFolders                CaseFolder[]
  clients                    Client[]
  complianceCases            ComplianceCase[]
  contracts                  Contract[]
  developmentProjectProfiles DevelopmentProjectProfile[]
  documentTemplates          DocumentTemplate[]
  hearings                   Hearing[]
  invoices                   Invoice[]
  knowledgeItems             KnowledgeItem[]
  Lead                       Lead[]
  matters                    Matter[]
  matterAccessList           MatterAccess[]
  conflictChecks             MatterConflictCheck[]
  deadlines                  MatterDeadline[]
  feeAgreements              MatterFeeAgreement[]
  importDrafts               MatterImportDraft[]
  messages                   MatterMessage[]
  parties                    MatterParty[]
  payments                   MatterPayment[]
  notifications              Notification[]
  portalShares               PortalShare[]
  Property                   Property[]
  tasks                      Task[]
  Unit                       Unit[]
  users                      User[]
  WafiEscrowAccount          WafiEscrowAccount[]
  WafiProgressReport         WafiProgressReport[]
  contractTemplates          ContractTemplate[]
}

model User {
  id                     String                 @id @default(uuid())
  tenantId               String
  name                   String
  email                  String                 @unique
  password               String
  mustChangePassword     Boolean                @default(false)
  sessionVersion         Int                    @default(0)
  canCreateCase          Boolean                @default(false)
  role                   String
  isActive               Boolean                @default(true)
  mfaEnabled             Boolean                @default(false)
  mfaSecret              String?
  avatarUrl              String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  modulePermissions      String                 @default("{}")
  auditLogs              AuditLog[]
  createdFolders         CaseFolder[]           @relation("FolderCreator")
  updatedTemplates       DocumentTemplate[]     @relation("TemplateUpdaters")
  authoredTemplates      DocumentTemplate[]     @relation("TemplateAuthors")
  authoredKnowledgeItems KnowledgeItem[]        @relation("KnowledgeAuthors")
  archivedMatters        Matter[]               @relation("MatterArchiver")
  matterStatusUpdates    Matter[]               @relation("MatterStatusUpdater")
  matters                Matter[]               @relation("LawyerMatters")
  grantedAccessList      MatterAccess[]         @relation("AccessGrantor")
  matterAccessList       MatterAccess[]         @relation("UserMatterAccess")
  acknowledgedConflicts  MatterConflictCheck[]  @relation("ConflictAcknowledger")
  assignedDeadlines      MatterDeadline[]       @relation("DeadlineAssignee")
  createdDeadlines       MatterDeadline[]       @relation("DeadlineCreator")
  confirmedImportDrafts  MatterImportDraft[]    @relation("ImportConfirmedBy")
  uploadedImportDrafts   MatterImportDraft[]    @relation("ImportUploadedBy")
  messages               MatterMessage[]
  mentions               MatterMessageMention[]
  receivedPayments       MatterPayment[]        @relation("PaymentReceiver")
  statusHistory          MatterStatusHistory[]
  notifications          Notification[]
  Property               Property[]
  tasks                  Task[]
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  viewableFolders        CaseFolder[]           @relation("FolderViewers")
  teamMatters            Matter[]               @relation("MatterTeam")
}

model Client {
  id                 String           @id @default(uuid())
  tenantId           String
  name               String
  email              String?
  phone              String?
  type               String           @default("individual")
  status             String           @default("active")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  complianceCases    ComplianceCase[]
  contracts          Contract[]
  invoices           Invoice[]
  beneficiaryMatters Matter[]         @relation("BeneficiaryAccount")
  matters            Matter[]
  portalShares       PortalShare[]
  Unit               Unit[]
}

model Matter {
  id                   String                     @id @default(uuid())
  tenantId             String
  clientId             String?
  beneficiaryAccountId String?
  title                String
  caseNumber           String?
  status               String                     @default("NEW")
  statusUpdatedAt      DateTime?
  statusUpdatedById    String?
  lawyerId             String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  folderId             String?
  externalPartyName    String?
  externalPartyType    String?
  externalPartyPhone   String?
  externalPartyEmail   String?
  externalPartyNotes   String?
  notes                String?
  dueDate              DateTime?
  isArchived           Boolean                    @default(false)
  archivedAt           DateTime?
  archivedById         String?
  archiveReason        String?
  developmentProfile   DevelopmentProjectProfile?
  documents            Document[]
  hearings             Hearing[]
  invoices             Invoice[]
  archivedBy           User?                      @relation("MatterArchiver", fields: [archivedById], references: [id])
  folder               CaseFolder?                @relation(fields: [folderId], references: [id])
  statusUpdatedBy      User?                      @relation("MatterStatusUpdater", fields: [statusUpdatedById], references: [id])
  tenant               Tenant                     @relation(fields: [tenantId], references: [id])
  beneficiaryAccount   Client?                    @relation("BeneficiaryAccount", fields: [beneficiaryAccountId], references: [id], onDelete: Restrict)
  client               Client?                    @relation(fields: [clientId], references: [id])
  lawyer               User?                      @relation("LawyerMatters", fields: [lawyerId], references: [id])
  accessList           MatterAccess[]
  conflictChecks       MatterConflictCheck[]
  deadlines            MatterDeadline[]
  feeAgreement         MatterFeeAgreement?
  messages             MatterMessage[]
  parties              MatterParty[]
  payments             MatterPayment[]
  statusHistory        MatterStatusHistory[]
  portalShares         PortalShare[]
  tasks                Task[]
  teamMembers          User[]                     @relation("MatterTeam")

  @@index([tenantId, lawyerId])
}

model DevelopmentProjectProfile {
  id                           String    @id @default(uuid())
  tenantId                     String
  matterId                     String    @unique
  projectCode                  String?
  city                         String?
  region                       String?
  stage                        String    @default("PLANNING")
  plannedStart                 DateTime?
  plannedEnd                   DateTime?
  projectValue                 Float     @default(0)
  budgetAtCompletion           Float     @default(0)
  plannedValue                 Float     @default(0)
  earnedValue                  Float     @default(0)
  actualCost                   Float     @default(0)
  totalUnits                   Int       @default(0)
  soldUnits                    Int       @default(0)
  collectedAmount              Float     @default(0)
  offPlanStatus                String    @default("NOT_APPLICABLE")
  buildingPermitStatus         String    @default("NOT_STARTED")
  buildingCodeStatus           String    @default("NOT_STARTED")
  occupancyStatus              String    @default("NOT_STARTED")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  latentDefectsInsuranceStatus String    @default("NOT_STARTED")
  matter                       Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  tenant                       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stage])
}

model MatterStatusHistory {
  id          String   @id @default(uuid())
  matterId    String
  oldStatus   String?
  newStatus   String
  changedById String
  note        String?
  createdAt   DateTime @default(now())
  changedBy   User     @relation(fields: [changedById], references: [id])
  matter      Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, createdAt])
}

model Hearing {
  id        String   @id @default(uuid())
  tenantId  String?
  matterId  String
  type      String   @default("HEARING")
  title     String?
  date      DateTime
  court     String
  summary   String?
  status    String   @default("upcoming")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, date])
  @@index([tenantId, date])
}

model Task {
  id          String    @id @default(uuid())
  tenantId    String?
  matterId    String?
  userId      String?
  title       String
  description String?
  priority    String    @default("MEDIUM")
  status      String    @default("NEW")
  isDone      Boolean   @default(false)
  isUrgent    Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter      Matter?   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([matterId])
  @@index([tenantId, status])
}

model Document {
  id        String   @id @default(uuid())
  matterId  String
  title     String
  fileUrl   String
  type      String   @default("pdf")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matter    Matter   @relation(fields: [matterId], references: [id])
}

model Invoice {
  id        String    @id @default(uuid())
  tenantId  String
  clientId  String
  matterId  String?
  amount    Float
  status    String    @default("unpaid")
  dueDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  matter    Matter?   @relation(fields: [matterId], references: [id])
  client    Client    @relation(fields: [clientId], references: [id])
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model ContractTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  content   String 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contracts Contract[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
}

model Contract {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String?
  leadId      String?
  unitId      String?
  templateId  String?
  title       String
  summary     String?
  content     String?
  generatedHtml String?
  status      String   @default("DRAFT") // DRAFT, SENT, SIGNED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  client      Client?  @relation(fields: [clientId], references: [id])
  lead        Lead?    @relation(fields: [leadId], references: [id])
  unit        Unit?    @relation(fields: [unitId], references: [id])
  template    ContractTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId])
  @@index([templateId])
  @@index([leadId])
  @@index([unitId])
}

model MatterMessage {
  id               String                 @id @default(uuid())
  tenantId         String
  matterId         String
  authorId         String
  body             String
  replyToMessageId String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  clientRequestId  String?
  replyTo          MatterMessage?         @relation("Replies", fields: [replyToMessageId], references: [id])
  replies          MatterMessage[]        @relation("Replies")
  author           User                   @relation(fields: [authorId], references: [id])
  matter           Matter                 @relation(fields: [matterId], references: [id])
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  mentions         MatterMessageMention[]

  @@unique([authorId, clientRequestId])
  @@index([tenantId, matterId, createdAt])
}

model MatterMessageMention {
  id              String        @id @default(uuid())
  messageId       String
  mentionedUserId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [mentionedUserId], references: [id])
  message         MatterMessage @relation(fields: [messageId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
}

model ComplianceCase {
  id          String   @id @default(uuid())
  tenantId    String
  clientId    String?
  title       String
  caseType    String
  riskLevel   String   @default("medium")
  status      String   @default("under_review")
  restriction String?
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client?  @relation(fields: [clientId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, riskLevel])
}

model KnowledgeItem {
  id          String   @id @default(uuid())
  tenantId    String
  createdById String
  title       String
  category    String
  content     String
  fileName    String?
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("KnowledgeAuthors", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, category])
  @@index([tenantId, createdAt])
}

model PortalShare {
  id           String    @id @default(uuid())
  tenantId     String
  matterId     String
  clientId     String?
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  client       Client?   @relation(fields: [clientId], references: [id])
  matter       Matter    @relation(fields: [matterId], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([matterId, revokedAt])
  @@index([expiresAt])
}

model CaseFolder {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("FolderCreator", fields: [createdById], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  matters     Matter[]
  viewers     User[]   @relation("FolderViewers")

  @@index([tenantId])
}

model MatterImportDraft {
  id               String    @id @default(uuid())
  tenantId         String
  uploadedById     String
  sourceDocumentId String?
  filePath         String
  fileName         String
  extractedData    String
  confidence       String
  status           String    @default("PENDING_REVIEW")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  confirmedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?     @relation("ImportConfirmedBy", fields: [confirmedById], references: [id])
  uploadedBy       User      @relation("ImportUploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([uploadedById])
}

model DocumentTemplate {
  id           String   @id @default(uuid())
  tenantId     String
  title        String
  description  String?
  category     String   @default("OTHER")
  practiceArea String   @default("GENERAL")
  templateType String   @default("GENERAL")
  content      String
  isActive     Boolean  @default(true)
  createdById  String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    User?    @relation("TemplateUpdaters", fields: [updatedById], references: [id])
  createdBy    User     @relation("TemplateAuthors", fields: [createdById], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@index([tenantId, practiceArea, isActive])
}

model MatterConflictCheck {
  id                String    @id @default(uuid())
  tenantId          String
  matterId          String?
  checkedName       String
  matchedEntityType String
  matchedEntityId   String?
  riskLevel         String
  reason            String
  acknowledgedById  String?
  acknowledgedAt    DateTime?
  createdAt         DateTime  @default(now())
  acknowledgedBy    User?     @relation("ConflictAcknowledger", fields: [acknowledgedById], references: [id])
  matter            Matter?   @relation(fields: [matterId], references: [id])
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, checkedName])
}

model MatterParty {
  id             String   @id @default(uuid())
  matterId       String
  tenantId       String
  name           String
  partyType      String   @default("PERSON")
  role           String   @default("THIRD_PARTY")
  nationalIdOrCr String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter         Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId, name])
}

model MatterDeadline {
  id           String    @id @default(uuid())
  matterId     String
  tenantId     String
  title        String
  deadlineType String    @default("SUBMISSION_DEADLINE")
  dueDate      DateTime
  reminderDate DateTime?
  status       String    @default("OPEN")
  notes        String?
  createdById  String
  assignedToId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User?     @relation("DeadlineAssignee", fields: [assignedToId], references: [id])
  createdBy    User      @relation("DeadlineCreator", fields: [createdById], references: [id])
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter       Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId, dueDate])
  @@index([tenantId, status])
}

model MatterFeeAgreement {
  id            String   @id @default(uuid())
  matterId      String   @unique
  tenantId      String
  totalFee      Float
  currency      String   @default("SAR")
  paymentStatus String   @default("UNPAID")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter        Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([tenantId, paymentStatus])
}

model MatterPayment {
  id           String   @id @default(uuid())
  matterId     String
  tenantId     String
  amount       Float
  paymentDate  DateTime @default(now())
  method       String   @default("BANK_TRANSFER")
  reference    String?
  notes        String?
  receivedById String
  createdAt    DateTime @default(now())
  receivedBy   User     @relation("PaymentReceiver", fields: [receivedById], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([tenantId])
}

model MatterAccess {
  id                  String   @id @default(uuid())
  matterId            String
  tenantId            String
  userId              String
  accessRole          String   @default("ASSIGNED_LAWYER")
  canView             Boolean  @default(true)
  canEdit             Boolean  @default(false)
  canManageDocuments  Boolean  @default(true)
  canManageTasks      Boolean  @default(true)
  canManageHearings   Boolean  @default(true)
  canViewFinancials   Boolean  @default(false)
  canManageFinancials Boolean  @default(false)
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           User     @relation("AccessGrantor", fields: [createdById], references: [id])
  user                User     @relation("UserMatterAccess", fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matter              Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
  @@index([tenantId, userId])
}

model Lead {
  id                   String    @id
  tenantId             String
  name                 String
  phone                String
  email                String?
  interestedPropertyId String?
  budget               Float?
  status               String    @default("NEW")
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  Property             Property? @relation(fields: [interestedPropertyId], references: [id])
  Tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts            Contract[]

  @@index([interestedPropertyId])
  @@index([tenantId])
}

model Property {
  id                 String               @id
  tenantId           String
  name               String
  type               String               @default("MASTER_PLAN")
  location           String?
  totalArea          Float?
  status             String               @default("PLANNING")
  managerId          String?
  wafiLicenseNumber  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  Lead               Lead[]
  User               User?                @relation(fields: [managerId], references: [id])
  Tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Unit               Unit[]
  WafiEscrowAccount  WafiEscrowAccount?
  WafiProgressReport WafiProgressReport[]

  @@index([tenantId])
}

model Unit {
  id         String   @id
  tenantId   String
  propertyId String
  unitNumber String
  type       String   @default("APARTMENT")
  area       Float?
  price      Float?
  status     String   @default("AVAILABLE")
  buyerId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Client     Client?  @relation(fields: [buyerId], references: [id])
  Property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contracts  Contract[]

  @@index([propertyId])
  @@index([tenantId])
}

model WafiEscrowAccount {
  id               String   @id
  tenantId         String
  propertyId       String   @unique
  accountNumber    String
  bankName         String
  totalDeposits    Float    @default(0)
  availableBalance Float    @default(0)
  retainedBalance  Float    @default(0)
  status           String   @default("ACTIVE")
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  Property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WafiProgressReport {
  id                         String   @id
  tenantId                   String
  propertyId                 String
  reportDate                 DateTime
  engineeringConsultant      String
  approvedProgressPercentage Float
  status                     String   @default("PENDING")
  wafiCertificateUrl         String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime
  Property                   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  Tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([tenantId])
}
